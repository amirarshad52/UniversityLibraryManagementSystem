@model ULMS.Web.Controllers.StudentLoanListViewModel

@{
    ViewData["Title"] = "Borrowing History";
}

<style>
    body { background: #f5f7f4; }
    .st-page { padding: 35px 0 45px; color: #23372b; }
    .st-heading { color: #23372b; font-weight: 700; }
    .st-muted { color: #718078; }
    .st-card { background: white; border: 1px solid #e8eee9; border-radius: 15px; box-shadow: 0 4px 15px rgba(35,55,43,.045); overflow: hidden; }
    .st-card-body { padding: 24px; }
    .st-table { margin-bottom: 0; }
    .st-table thead th { background: #f1f7f2; color: #52675a; border-top: 0; border-bottom: 1px solid #e3ebe5; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; padding: 15px; white-space: nowrap; }
    .st-table td { padding: 16px 15px; vertical-align: middle; border-color: #edf1ee; color: #405247; }
    .st-table tbody tr:hover { background: #f8fbf8; }
    .st-badge { display: inline-block; padding: 6px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .st-green { background: #e5f3e8; color: #287443; }
    .st-yellow { background: #fff3d8; color: #946b16; }
    .st-red { background: #fde8e7; color: #b33c35; }
    .st-blue { background: #e8f0f8; color: #426b91; }
    .st-btn { background: #34734c; border-color: #34734c; color: white; border-radius: 8px; font-weight: 600; }
    .st-btn:hover { background: #245b38; border-color: #245b38; color: white; }
</style>

<div class="st-page">
    <div class="container">

        <div class="mb-4">
            <div class="small st-muted font-weight-bold mb-2" style="letter-spacing:1px;">YOUR LIBRARY RECORDS</div>
            <h2 class="st-heading mb-2">Borrowing History</h2>
            <p class="st-muted mb-0">Your previous and current borrowing records.</p>
        </div>

        <div class="st-card">
            <div class="st-card-body">
                @if (Model.Records == null || !Model.Records.Any())
                {
                    <div class="text-center py-5">
                        <div class="mx-auto mb-3" style="width:60px;height:60px;border-radius:17px;background:#eaf3ec;color:#34734c;display:flex;align-items:center;justify-content:center;font-size:27px;">&#9776;</div>
                        <h5 class="st-heading">No Borrowing History</h5>
                        <p class="st-muted">Your borrowing records will appear here.</p>
                        <a asp-controller="Student" asp-action="Books" class="btn st-btn">Explore Books</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table st-table">
                            <thead>
                                <tr>
                                    <th>Book</th>
                                    <th>Copy Code</th>
                                    <th>Library</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Return Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Records)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.BookTitle</strong><br />
                                            <small class="st-muted">@item.Author</small>
                                        </td>
                                        <td>@item.CopyCode</td>
                                        <td>@item.LibraryName</td>
                                        <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (item.ReturnDate.HasValue)
                                            {
                                                @item.ReturnDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="st-muted">Not returned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.ReturnDate.HasValue)
                                            {
                                                <span class="st-badge st-green">Returned</span>
                                            }
                                            else if (item.DueDate.Date < Model.Today.Date)
                                            {
                                                <span class="st-badge st-red">Overdue</span>
                                            }
                                            else if (item.DueDate.Date <= Model.Today.Date.AddDays(3))
                                            {
                                                <span class="st-badge st-yellow">Due Soon</span>
                                            }
                                            else
                                            {
                                                <span class="st-badge st-blue">Issued</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="st-muted small mt-3 mb-0">Showing the latest 200 borrowing records.</p>
                }
            </div>
        </div>

    </div>
</div>