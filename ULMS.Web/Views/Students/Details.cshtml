@model ULMS.Web.Controllers.StudentBookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<style>
    body { background: #f5f7f4; }
    .st-page { padding: 35px 0 45px; color: #23372b; }
    .st-heading { color: #23372b; font-weight: 700; }
    .st-muted { color: #718078; }
    .st-card { background: white; border: 1px solid #e8eee9; border-radius: 15px; box-shadow: 0 4px 15px rgba(35,55,43,.045); overflow: hidden; }
    .st-card-body { padding: 25px; }
    .st-cover { background: #f1f7f2; border-radius: 13px; min-height: 310px; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .st-cover img { max-height: 330px; max-width: 100%; object-fit: contain; }
    .st-btn-outline { color: #34734c; border: 1px solid #34734c; background: transparent; border-radius: 8px; font-weight: 600; }
    .st-btn-outline:hover { background: #34734c; color: white; }
    .st-badge { display: inline-block; padding: 7px 11px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .st-green { background: #e5f3e8; color: #287443; }
    .st-yellow { background: #fff3d8; color: #946b16; }
    .st-grey { background: #edf0ed; color: #66736a; }
    .st-table { margin-bottom: 0; }
    .st-table thead th { background: #f1f7f2; color: #52675a; border-top: 0; border-bottom: 1px solid #e3ebe5; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; padding: 15px; white-space: nowrap; }
    .st-table td { padding: 16px 15px; vertical-align: middle; border-color: #edf1ee; color: #405247; }
    .st-table tbody tr:hover { background: #f8fbf8; }
    .st-description { color: #52645a; line-height: 1.8; white-space: pre-line; }
</style>

<div class="st-page">
    <div class="container">

        <div class="mb-4">
            <a asp-controller="Student" asp-action="Books" class="btn st-btn-outline btn-sm">
                &larr; Back to Catalogue
            </a>
        </div>

        <div class="st-card mb-4">
            <div class="st-card-body">
                <div class="row">
                    <div class="col-md-4 mb-4 mb-md-0">
                        <div class="st-cover">
                            @if (!string.IsNullOrWhiteSpace(Model.Book.CoverImagePath))
                            {
                                <img src="@Url.Content(Model.Book.CoverImagePath)" alt="@Model.Book.Title" />
                            }
                            else
                            {
                                <div class="text-center st-muted">
                                    <div style="font-size:55px;color:#9caf9f;">&#128218;</div>
                                    <div>No Cover Image</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-8 pl-md-4">
                        <div class="small st-muted font-weight-bold mb-2" style="letter-spacing:1px;">BOOK INFORMATION</div>

                        <h2 class="st-heading mb-2">@Model.Book.Title</h2>
                        <h5 class="st-muted font-weight-normal mb-4">By @Model.Book.Author</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Book.ISBN))
                        {
                            <div class="mb-3">
                                <span class="st-muted">ISBN:</span>
                                <strong>@Model.Book.ISBN</strong>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Book.Description))
                        {
                            <h6 class="st-heading mt-4 mb-2">Description</h6>
                            <p class="st-description">@Model.Book.Description</p>
                        }

                        <div class="mt-4">
                            <span class="st-badge st-grey">Total Copies: @Model.TotalCopies</span>
                            <span class="st-badge st-green">Available Copies: @Model.AvailableCopies</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <h4 class="st-heading mb-1">Library Availability</h4>
            <p class="st-muted mb-0">Check the physical copies available across university libraries.</p>
        </div>

        <div class="st-card">
            <div class="table-responsive">
                @if (Model.Copies == null || !Model.Copies.Any())
                {
                    <div class="text-center py-5 px-3">
                        <div class="mb-3" style="font-size:38px;color:#9caf9f;">&#128218;</div>
                        <h5 class="st-heading">No Physical Copies Available</h5>
                        <p class="st-muted mb-0">This book has not been added to a library yet.</p>
                    </div>
                }
                else
                {
                    <table class="table st-table">
                        <thead>
                            <tr>
                                <th>Library</th>
                                <th>Location</th>
                                <th>Copy Code</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var copy in Model.Copies)
                            {
                                <tr>
                                    <td><strong>@copy.LibraryName</strong></td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(copy.LibraryLocation)
                                            ? "Not specified"
                                            : copy.LibraryLocation)
                                    </td>
                                    <td>@copy.CopyCode</td>
                                    <td>
                                        @if (copy.Status == "Available")
                                        {
                                            <span class="st-badge st-green">Available</span>
                                        }
                                        else if (copy.Status == "Issued")
                                        {
                                            <span class="st-badge st-yellow">Issued</span>
                                        }
                                        else
                                        {
                                            <span class="st-badge st-grey">Maintenance</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>