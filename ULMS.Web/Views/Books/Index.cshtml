
@model IEnumerable<ULMS.Web.Entities.Book>

@using System
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Books Catalogue";

    var availableCopies =
        ViewBag.AvailableCopies as IDictionary<int, int>
        ?? new Dictionary<int, int>();

    var books = Model?.ToList() ?? new List<ULMS.Web.Entities.Book>();
}

<style>
    .books-page {
        padding: 65px 0 85px;
        background: #f7f9fc;
        min-height: 75vh;
    }

    .books-heading {
        text-align: center;
        margin-bottom: 38px;
    }

    .section-label {
        display: inline-block;
        color: #2563eb;
        background: #eaf1ff;
        padding: 7px 17px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 16px;
    }

    .books-heading h1 {
        font-size: 38px;
        font-weight: 800;
        color: #172554;
        margin-bottom: 12px;
    }

    .books-heading h1 span {
        color: #2563eb;
    }

    .books-heading p {
        color: #64748b;
        font-size: 16px;
        max-width: 600px;
        margin: auto;
        line-height: 1.7;
    }

    .books-search {
        max-width: 650px;
        margin: 0 auto 55px;
        position: relative;
    }

    .books-search input {
        width: 100%;
        height: 58px;
        padding: 12px 22px 12px 54px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        outline: none;
        font-size: 15px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
        transition: .25s;
    }

    .books-search input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .search-icon {
        position: absolute;
        left: 19px;
        top: 17px;
        width: 23px;
        height: 23px;
        color: #64748b;
    }

    .search-icon svg {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
    }

    .books-results-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .books-results-heading h2 {
        color: #172554;
        font-size: 23px;
        font-weight: 750;
        margin: 0;
    }

    #bookCount {
        color: #2563eb;
        background: #eaf1ff;
        padding: 7px 15px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .book-card {
        height: 100%;
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: 15px;
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .04);
    }

    .book-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 15px 35px rgba(15, 23, 42, .11);
    }

    .book-cover {
        height: 245px;
        background: #edf2fa;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        padding: 18px;
    }

    .book-cover img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 5px;
        box-shadow: 0 8px 18px rgba(15, 23, 42, .15);
    }

    .book-cover-fallback {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #64748b;
        text-align: center;
    }

    .book-cover-fallback svg {
        width: 52px;
        height: 52px;
        margin-bottom: 10px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
    }

    .book-cover-fallback span {
        font-size: 12px;
        font-weight: 600;
    }

    .book-information {
        padding: 21px;
    }

    .book-information h3 {
        color: #172554;
        font-size: 17px;
        font-weight: 750;
        line-height: 1.5;
        margin-bottom: 7px;
        min-height: 50px;
    }

    .book-author {
        color: #2563eb;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .book-isbn {
        color: #94a3b8;
        font-size: 11px;
        margin-bottom: 14px;
        word-break: break-word;
    }

    .book-availability {
        border-top: 1px solid #edf0f5;
        padding-top: 14px;
        display: flex;
        align-items: center;
        font-size: 12px;
        font-weight: 700;
    }

    .availability-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 8px;
        flex-shrink: 0;
    }

    .availability-dot.available {
        background: #16a34a;
        box-shadow: 0 0 0 4px #dcfce7;
    }

    .availability-dot.unavailable {
        background: #dc2626;
        box-shadow: 0 0 0 4px #fee2e2;
    }

    .book-details-button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-top: 17px;
        padding: 11px 15px;
        border-radius: 9px;
        background: #2563eb;
        color: #fff !important;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important;
        transition: background .2s ease, transform .2s ease;
    }

    .book-details-button:hover {
        background: #1d4ed8;
        color: #fff !important;
        transform: translateY(-2px);
    }

    .book-details-button span {
        font-size: 18px;
    }

    .empty-books {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 15px;
        padding: 55px 20px;
        text-align: center;
        margin-bottom: 25px;
    }

    .empty-books h3 {
        color: #172554;
        font-size: 20px;
        font-weight: 750;
    }

    .empty-books p {
        color: #64748b;
        margin: 8px 0 0;
    }

    @@media (max-width: 576px) {
        .books-page {
            padding: 42px 0 60px;
        }

        .books-heading h1 {
            font-size: 29px;
        }

        .books-heading p {
            font-size: 14px;
        }

        .books-results-heading h2 {
            font-size: 19px;
        }

        .book-cover {
            height: 220px;
        }
    }
</style>

<section class="books-page">
    <div class="container">

        <div class="books-heading">

            <span class="section-label">
                UNIVERSITY LIBRARY
            </span>

            <h1>
                Explore Our <span>Books</span>
            </h1>

            <p>
                Discover academic resources and explore the books
                available across the university library catalogue.
            </p>

        </div>

        <div class="books-search">

            <span class="search-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m16 16 5 5"></path>
                </svg>
            </span>

            <input type="text"
                   id="bookSearch"
                   placeholder="Search by book title, author or ISBN..."
                   aria-label="Search books" />

        </div>

        <div class="books-results-heading">

            <h2>Library Catalogue</h2>

            <span id="bookCount">
                @books.Count Books
            </span>

        </div>

        <div class="row" id="booksContainer">

            @if (books.Any())
            {
                foreach (var book in books)
                {
                    var availableCount =
                        availableCopies.ContainsKey(book.BookId)
                        ? availableCopies[book.BookId]
                        : 0;

                    <div class="col-sm-6 col-lg-4 col-xl-3 mb-4 book-item">

                        <article class="book-card">

                            <div class="book-cover">

                                @if (!String.IsNullOrWhiteSpace(book.CoverImagePath))
                                {
                                    <img src="@Url.Content(book.CoverImagePath)"
                                         alt="@book.Title"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                    <div class="book-cover-fallback" style="display:none;">

                                        <svg viewBox="0 0 24 24">
                                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22z"></path>
                                            <path d="M4 5.5V22M8 7h8M8 11h8"></path>
                                        </svg>

                                        <span>Cover unavailable</span>

                                    </div>
                                }
                                else
                                {
                                    <div class="book-cover-fallback">

                                        <svg viewBox="0 0 24 24">
                                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22z"></path>
                                            <path d="M4 5.5V22M8 7h8M8 11h8"></path>
                                        </svg>

                                        <span>Cover not available</span>

                                    </div>
                                }

                            </div>

                            <div class="book-information">

                                <h3>@book.Title</h3>

                                <p class="book-author">
                                    By @book.Author
                                </p>

                                @if (!String.IsNullOrWhiteSpace(book.ISBN))
                                {
                                    <p class="book-isbn">
                                        ISBN: @book.ISBN
                                    </p>
                                }

                                <div class="book-availability">

                                    @if (availableCount > 0)
                                    {
                                        <span class="availability-dot available"></span>
                                        <span>@availableCount Copies Available</span>
                                    }
                                    else
                                    {
                                        <span class="availability-dot unavailable"></span>
                                        <span>Currently Unavailable</span>
                                    }

                                </div>

                                <a href="@Url.Action("Details", "Books", new { id = book.BookId })"
                                   class="book-details-button">

                                    View Details

                                    <span>&rarr;</span>

                                </a>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="empty-books">

                        <h3>No Books Available</h3>

                        <p>
                            There are currently no books in the university catalogue.
                        </p>

                    </div>

                </div>
            }

        </div>

        <div id="noSearchResults" class="empty-books d-none">

            <h3>No Matching Books Found</h3>

            <p>
                Try searching with another title, author or ISBN.
            </p>

        </div>

    </div>
</section>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("bookSearch");
            const bookItems = document.querySelectorAll(".book-item");
            const bookCount = document.getElementById("bookCount");
            const noResults = document.getElementById("noSearchResults");

            function filterBooks() {

                const searchText = searchInput.value
                    .trim()
                    .toLowerCase();

                let visibleCount = 0;

                bookItems.forEach(function (item) {

                    const text = item.innerText.toLowerCase();
                    const matches = text.includes(searchText);

                    item.classList.toggle("d-none", !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                bookCount.textContent = visibleCount + " Books";

                noResults.classList.toggle(
                    "d-none",
                    visibleCount !== 0 || bookItems.length === 0
                );
            }

            searchInput.addEventListener("input", filterBooks);

        });
    </script>

}
