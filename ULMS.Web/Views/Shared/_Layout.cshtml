
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var isAdminPage =
        currentController == "Admin" ||
        currentController == "AdminProfile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ULMS</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom-3d.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header class="ulms-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">

                <a class="navbar-brand ulms-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/image/logo/ULMS%20LOGO.png"
                         alt="ULMS Logo"
                         class="brand-logo" />
                    <span>ULMS</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-toggle="collapse"
                        data-target="#ulmsNavbar"
                        aria-controls="ulmsNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="ulmsNavbar">

                    <ul class="navbar-nav ulms-main-nav">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Books"
                               asp-action="Index">
                                Books
                            </a>
                        </li>
                    </ul>

                    <div class="ulms-login-area">

                        @if (isAdminPage)
                        {
                            <a class="btn login-button"
                               href="/Admin/Profile">
                                Admin Profile
                                <span aria-hidden="true">→</span>
                            </a>
                        }
                        else
                        {
                            <a class="btn login-button" href="/Account/Login">
                                Login
                                <span aria-hidden="true">→</span>
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="ulms-footer">
        <div class="container">

            <div class="footer-main">

                <div class="footer-brand">
                    <div class="footer-brand-name">
                        <img src="~/image/logo/ULMS%20LOGO.png"
                             alt="ULMS Logo" />
                        <span>ULMS</span>
                    </div>

                    <p>
                        University Library Management System.
                        Discover academic books, explore learning resources
                        and stay connected with your university library.
                    </p>
                </div>

                <div class="footer-links">
                    <h5>Quick Links</h5>

                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Books" asp-action="Index">Books Catalogue</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>

                <div class="footer-social">
                    <h5>Connect With Me</h5>

                    <a href="https://github.com/amirarshad52"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-link">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor"
                                  d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.02-.7.08-.69.08-.69 1.12.08 1.7 1.15 1.7 1.15 1 .1.79 2.2 3.36 1.57.1-.73.39-1.23.7-1.51-2.47-.28-5.07-1.24-5.07-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.08 1.14a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.14 3.08-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.6 5.24-5.08 5.51.4.35.75 1.03.75 2.08v3.08c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z" />
                        </svg>
                        <span>GitHub</span>
                    </a>

                    <a href="https://www.linkedin.com/in/amir-arshad-40531725a"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-link">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor"
                                  d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM8.08 18.35H5.12V9.02h2.96v9.33ZM6.6 7.75a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.01 10.6h-2.95v-4.54c0-1.08-.02-2.47-1.5-2.47-1.5 0-1.73 1.17-1.73 2.39v4.62H9.48V9.02h2.83v1.27h.04c.4-.73 1.36-1.5 2.8-1.5 3 0 3.46 1.97 3.46 4.53v5.03Z" />
                        </svg>
                        <span>LinkedIn</span>
                    </a>
                </div>

            </div>

            <div class="footer-bottom">
                <p>© @DateTime.Now.Year ULMS. All Rights Reserved.</p>
                <p>University Library Management System</p>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
