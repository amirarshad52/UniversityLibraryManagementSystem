@model ULMS.Web.Controllers.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

<style>
    body { background: #f5f7f4; }
    .st-page { padding-top: 35px; padding-bottom: 45px; color: #23372b; }
    .st-hero { background: linear-gradient(135deg, #183d2b, #34734c); color: white; border-radius: 16px; padding: 30px; box-shadow: 0 8px 22px rgba(24,61,43,.13); }
    .st-hero p { color: #dce9df; }
    .st-card { background: white; border: 1px solid #e8eee9; border-radius: 15px; box-shadow: 0 4px 15px rgba(35,55,43,.045); height: 100%; }
    .st-card-body { padding: 23px; }
    .st-label { color: #718078; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
    .st-number { color: #23372b; font-size: 32px; font-weight: 700; margin: 8px 0; }
    .st-icon { width: 43px; height: 43px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: #eaf3ec; color: #34734c; font-size: 20px; font-weight: 700; }
    .st-link { color: #34734c; font-weight: 600; font-size: 13px; }
    .st-link:hover { color: #245b38; text-decoration: none; }
    .st-section-title { color: #23372b; font-weight: 700; }
    .st-table { margin-bottom: 0; }
    .st-table thead th { background: #f1f7f2; color: #52675a; border-top: 0; border-bottom: 1px solid #e3ebe5; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; padding: 14px; white-space: nowrap; }
    .st-table td { padding: 15px 14px; vertical-align: middle; border-color: #edf1ee; color: #405247; }
    .st-table tbody tr:hover { background: #f8fbf8; }
    .st-btn { background: #34734c; border-color: #34734c; color: white; border-radius: 8px; font-weight: 600; }
    .st-btn:hover { background: #245b38; border-color: #245b38; color: white; }
    .st-btn-outline { color: #34734c; border: 1px solid #34734c; background: transparent; border-radius: 8px; font-weight: 600; }
    .st-btn-outline:hover { background: #34734c; color: white; }
    .st-badge { display: inline-block; padding: 6px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .st-green { background: #e5f3e8; color: #287443; }
    .st-yellow { background: #fff3d8; color: #946b16; }
    .st-red { background: #fde8e7; color: #b33c35; }
    .st-blue { background: #e8f0f8; color: #426b91; }
    .st-muted { color: #718078; }
</style>

<div class="st-page">
    <div class="container">

        <div class="st-hero mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="small mb-2" style="color:#c7dfce; font-weight:600; letter-spacing:1px;">
                        STUDENT PORTAL
                    </div>
                    <h2 class="font-weight-bold mb-2">Welcome, @Model.StudentName</h2>
                    <p class="mb-0">@Model.StudentEmail</p>
                </div>
                <div class="col-md-4 text-md-right mt-3 mt-md-0">
                    <div class="small" style="color:#dce9df;">Today's Date</div>
                    <div class="font-weight-bold">@Model.Today.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="st-card">
                    <div class="st-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="st-label">Active Books</div>
                                <div class="st-number">@Model.ActiveBooks</div>
                                <a asp-controller="Student" asp-action="MyBorrowedBooks" class="st-link">View borrowed books &rarr;</a>
                            </div>
                            <div class="st-icon">&#128218;</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-3">
                <div class="st-card">
                    <div class="st-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="st-label">Returned Books</div>
                                <div class="st-number">@Model.ReturnedBooks</div>
                                <a asp-controller="Student" asp-action="History" class="st-link">View history &rarr;</a>
                            </div>
                            <div class="st-icon">&#10003;</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-3">
                <div class="st-card">
                    <div class="st-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="st-label">Total Records</div>
                                <div class="st-number">@Model.TotalBorrowingRecords</div>
                                <a asp-controller="Student" asp-action="History" class="st-link">View all records &rarr;</a>
                            </div>
                            <div class="st-icon">&#9776;</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="st-card">
                    <div class="st-card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="st-label">Overdue Books</div>
                                <div class="st-number" style="color:#b33c35;">@Model.OverdueBooks</div>
                                <small class="st-muted">Books whose due date has passed.</small>
                            </div>
                            <div class="st-icon" style="background:#fde8e7;color:#b33c35;">!</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="st-card">
                    <div class="st-card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="st-label">Due Soon</div>
                                <div class="st-number" style="color:#946b16;">@Model.DueSoonBooks</div>
                                <small class="st-muted">Books due within the next three calendar days.</small>
                            </div>
                            <div class="st-icon" style="background:#fff3d8;color:#946b16;">&#9200;</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="st-section-title mb-1">Recent Borrowing Activity</h4>
                <small class="st-muted">Your latest library transactions</small>
            </div>
            <a asp-controller="Student" asp-action="History" class="btn st-btn-outline btn-sm">View History</a>
        </div>

        <div class="st-card">
            <div class="table-responsive">
                @if (Model.RecentActivities == null || !Model.RecentActivities.Any())
                {
                    <div class="text-center py-5 px-3">
                        <div class="st-icon mx-auto mb-3" style="width:55px;height:55px;">&#128218;</div>
                        <h5 class="font-weight-bold">No borrowing activity yet</h5>
                        <p class="st-muted">Your borrowing records will appear here.</p>
                        <a asp-controller="Student" asp-action="Books" class="btn st-btn">Explore Books</a>
                    </div>
                }
                else
                {
                    <table class="table st-table">
                        <thead>
                            <tr>
                                <th>Book</th>
                                <th>Library</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentActivities)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.BookTitle</strong><br />
                                        <small class="st-muted">@item.Author</small>
                                    </td>
                                    <td>@item.LibraryName</td>
                                    <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (item.ReturnDate.HasValue)
                                        {
                                            <span class="st-badge st-green">Returned</span>
                                        }
                                        else if (item.DueDate.Date < Model.Today.Date)
                                        {
                                            <span class="st-badge st-red">Overdue</span>
                                        }
                                        else if (item.DueDate.Date <= Model.Today.Date.AddDays(3))
                                        {
                                            <span class="st-badge st-yellow">Due Soon</span>
                                        }
                                        else
                                        {
                                            <span class="st-badge st-blue">Issued</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>