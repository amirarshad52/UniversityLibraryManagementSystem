
@using System
@using System.Collections.Generic
@using Microsoft.AspNetCore.Mvc.Rendering
@model ULMS.Web.ViewModels.CreateStaffViewModel

@{
    ViewData["Title"] = "Staff Management";
}

<style>
    .staff-page {
        background: #f5f7f4;
        min-height: 100vh;
        padding: 35px 0 55px;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #26352f;
    }

    .staff-container {
        max-width: 1250px;
    }

    .staff-heading {
        margin-bottom: 25px;
    }

    .staff-eyebrow {
        color: #a17b43;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 9px;
    }

    .staff-heading h1 {
        color: #173f35;
        font-size: 30px;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .staff-heading p {
        color: #78847d;
        font-size: 14px;
        margin: 0;
    }

    .staff-banner {
        background: linear-gradient(115deg, #173f35, #102d26);
        border-radius: 15px;
        padding: 25px 30px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 10px 25px rgba(23, 63, 53, .12);
    }

    .staff-banner h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .staff-banner p {
        color: #d4dfd9;
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
    }

    .staff-card {
        background: #fff;
        border: 1px solid #edf0ec;
        border-radius: 13px;
        padding: 25px;
        height: 100%;
        box-shadow: 0 5px 18px rgba(28, 55, 44, .045);
    }

    .staff-card-heading {
        display: flex;
        align-items: center;
        margin-bottom: 23px;
    }

    .staff-card-icon {
        width: 43px;
        height: 43px;
        border-radius: 11px;
        background: #edf4f0;
        color: #173f35;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 13px;
        flex-shrink: 0;
    }

    .staff-card-icon svg {
        width: 22px;
        height: 22px;
    }

    .staff-card-heading h3 {
        font-size: 18px;
        font-weight: 700;
        color: #173f35;
        margin: 0 0 4px;
    }

    .staff-card-heading span {
        font-size: 12px;
        color: #89938d;
    }

    .staff-label {
        color: #34483d;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .staff-input {
        height: 45px;
        border: 1px solid #e1e8e2;
        border-radius: 7px;
        font-size: 13px;
        color: #26352f;
        box-shadow: none !important;
    }

    .staff-input:focus {
        border-color: #a17b43;
        box-shadow: 0 0 0 3px rgba(161, 123, 67, .10) !important;
    }

    .staff-field {
        margin-bottom: 19px;
    }

    .staff-help {
        color: #929c95;
        font-size: 11px;
        margin-top: 7px;
        line-height: 1.5;
    }

    .staff-submit {
        background: #173f35;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 12px 21px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s;
    }

    .staff-submit:hover {
        background: #245c4b;
        color: #fff;
    }

    .staff-table {
        margin-bottom: 0;
        font-size: 13px;
    }

    .staff-table thead th {
        background: #f5f8f5;
        color: #64736a;
        border-top: none;
        border-bottom: 1px solid #e9eee9;
        padding: 14px 12px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .staff-table tbody td {
        padding: 15px 12px;
        vertical-align: middle;
        color: #526057;
        border-top: 1px solid #edf0ec;
    }

    .staff-table tbody tr:hover {
        background: #fbfcfa;
    }

    .staff-name {
        color: #173f35;
        font-weight: 700;
    }

    .staff-library {
        color: #a17b43;
        font-weight: 600;
    }

    .staff-empty {
        text-align: center;
        padding: 40px 15px;
        color: #87918b;
    }

    .staff-empty svg {
        width: 42px;
        height: 42px;
        color: #b7c3bb;
        margin-bottom: 12px;
    }

    .staff-empty h4 {
        color: #526057;
        font-size: 15px;
        font-weight: 700;
    }

    .staff-empty p {
        font-size: 12px;
        margin: 0;
    }

    .staff-alert {
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .validation-message {
        color: #c0392b;
        font-size: 11px;
        display: block;
        margin-top: 5px;
    }

    .staff-role-badge {
        display: inline-block;
        background: #edf4f0;
        color: #245c4b;
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    /* Staff actions */
    .staff-actions {
        min-width: 175px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
    }

    .staff-transfer-form {
        width: 100%;
        min-width: 165px;
    }

    .staff-transfer-select {
        width: 100%;
        height: 34px;
        padding: 4px 7px;
        border: 1px solid #dfe7e0;
        border-radius: 6px;
        color: #34483d;
        background: #fff;
        font-size: 11px;
        outline: none;
    }

    .staff-transfer-select:focus {
        border-color: #a17b43;
        box-shadow: 0 0 0 2px rgba(161, 123, 67, .10);
    }

    .staff-transfer-button {
        width: 100%;
        margin-top: 6px;
        background: #173f35;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 700;
        transition: .2s;
    }

    .staff-transfer-button:hover {
        background: #245c4b;
        color: #fff;
    }

    .staff-status-form {
        margin: 0;
    }

    .staff-status-form button {
        min-width: 85px;
        font-size: 11px;
        font-weight: 600;
    }

    .staff-transfer-note {
        color: #89938d;
        font-size: 10px;
        line-height: 1.4;
        margin-top: 4px;
    }

    @@media (max-width: 767px) {
        .staff-page {
            padding: 24px 0 40px;
        }

        .staff-heading h1 {
            font-size: 25px;
        }

        .staff-card {
            padding: 19px;
        }

        .staff-banner {
            padding: 22px;
        }
    }
</style>

<div class="staff-page">
    <div class="container-fluid staff-container">

        <!-- Page Heading -->
        <div class="staff-heading">
            <div class="staff-eyebrow">
                Administration Workspace
            </div>

            <h1>Staff Management</h1>

            <p>
                Create staff accounts and manage staff members' assigned university libraries.
            </p>
        </div>

        <!-- Banner -->
        <div class="staff-banner">
            <h3>Manage Your Library Team</h3>

            <p>
                Register university library staff members and assign each
                member to their respective library. You can also transfer
                an existing staff member to another library without
                changing their account or borrowing history.
            </p>
        </div>

        <!-- Notifications -->
        @if (TempData["StaffSuccess"] != null)
        {
            <div class="alert alert-success staff-alert">
                @TempData["StaffSuccess"]
            </div>
        }

        @if (TempData["StaffError"] != null)
        {
            <div class="alert alert-danger staff-alert">
                @TempData["StaffError"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger staff-alert">
                Please review the information entered below.
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <div class="row">

            <!-- Add Staff Form -->
            <div class="col-lg-5 mb-4">
                <div class="staff-card">

                    <div class="staff-card-heading">
                        <div class="staff-card-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M19 8v6M22 11h-6"/>
                            </svg>
                        </div>

                        <div>
                            <h3>Add New Staff</h3>
                            <span>Create a staff account</span>
                        </div>
                    </div>

                    @if (ViewBag.Libraries != null &&
                         ((IEnumerable<SelectListItem>)ViewBag.Libraries).Any())
                    {
                        <form asp-controller="Admin"
                              asp-action="AddStaff"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="staff-field">
                                <label asp-for="Name" class="staff-label"></label>

                                <input asp-for="Name"
                                       class="form-control staff-input"
                                       placeholder="Enter staff full name"
                                       autocomplete="name" />

                                <span asp-validation-for="Name"
                                      class="validation-message"></span>
                            </div>

                            <div class="staff-field">
                                <label asp-for="Email" class="staff-label"></label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control staff-input"
                                       placeholder="name@uol.edu.pk"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="validation-message"></span>

                                <div class="staff-help">
                                    Only UOL university email addresses are eligible.
                                </div>
                            </div>

                            <div class="staff-field">
                                <label asp-for="LibraryId"
                                       class="staff-label"></label>

                                <select asp-for="LibraryId"
                                        asp-items="ViewBag.Libraries"
                                        class="form-control staff-input">
                                    <option value="">Select a library</option>
                                </select>

                                <span asp-validation-for="LibraryId"
                                      class="validation-message"></span>
                            </div>

                            <div class="staff-field">
                                <label class="staff-label">Account Role</label>

                                <div>
                                    <span class="staff-role-badge">Library Staff</span>
                                </div>

                                <div class="staff-help">
                                    The system automatically assigns the Staff role.
                                </div>
                            </div>

                            <button type="submit" class="btn staff-submit btn-block">
                                Create Staff Account
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning staff-alert">
                            No libraries are registered yet.
                            Please add a library before creating staff accounts.
                        </div>

                        <a asp-controller="Admin"
                           asp-action="Libraries"
                           class="btn staff-submit btn-block">
                            Manage Libraries
                        </a>
                    }

                </div>
            </div>

            <!-- Staff List -->
            <div class="col-lg-7 mb-4">
                <div class="staff-card">

                    <div class="staff-card-heading">
                        <div class="staff-card-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8">
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M2 21v-2a7 7 0 0 1 14 0v2"/>
                                <path d="M19 8v6M22 11h-6"/>
                            </svg>
                        </div>

                        <div>
                            <h3>Registered Staff</h3>
                            <span>Staff members and library assignments</span>
                        </div>
                    </div>

                    <div class="table-responsive">

                        <table class="table staff-table">
                            <thead>
                                <tr>
                                    <th>Staff Member</th>
                                    <th>Email</th>
                                    <th>Assigned Library</th>
                                    <th>Account Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (ViewBag.StaffMembers != null &&
                                     ((IEnumerable<object[]>)ViewBag.StaffMembers).Any())
                                {
                                    foreach (var staff in (IEnumerable<object[]>)ViewBag.StaffMembers)
                                    {
                                        int staffUserId = Convert.ToInt32(staff[0]);
                                        int currentLibraryId = Convert.ToInt32(staff[5]);
                                        bool isActive = Convert.ToBoolean(staff[4]);

                                        <tr>
                                            <td>
                                                <span class="staff-name">@staff[1]</span>
                                            </td>

                                            <td>@staff[2]</td>

                                            <td>
                                                <span class="staff-library">@staff[3]</span>
                                            </td>

                                            <td>
                                                @if (isActive)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Disabled</span>
                                                }
                                            </td>

                                            <td>
                                                <div class="staff-actions">

                                                    <!-- Change Assigned Library -->
                                                    @if (ViewBag.Libraries != null &&
                                                         ((IEnumerable<SelectListItem>)ViewBag.Libraries).Any())
                                                    {
                                                        <form asp-controller="Admin"
                                                              asp-action="ChangeStaffLibrary"
                                                              method="post"
                                                              class="staff-transfer-form"
                                                              onsubmit="return confirm('Are you sure you want to transfer this staff member to the selected library?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="userId"
                                                                   value="@staffUserId" />

                                                            <select name="libraryId"
                                                                    class="staff-transfer-select"
                                                                    required>

                                                                @foreach (var library in (IEnumerable<SelectListItem>)ViewBag.Libraries)
                                                                {
                                                                    <option value="@library.Value"
                                                                            selected="@(Convert.ToInt32(library.Value) == currentLibraryId ? "selected" : null)">
                                                                        @library.Text
                                                                    </option>
                                                                }

                                                            </select>

                                                            <button type="submit"
                                                                    class="btn staff-transfer-button">
                                                                Change Library
                                                            </button>

                                                            <div class="staff-transfer-note">
                                                                Current assignment: @staff[3]
                                                            </div>

                                                        </form>
                                                    }

                                                    <!-- Activate / Disable -->
                                                    @if (isActive)
                                                    {
                                                        <form asp-controller="Admin"
                                                              asp-action="DisableStaff"
                                                              method="post"
                                                              class="staff-status-form"
                                                              onsubmit="return confirm('Are you sure you want to disable this Staff account?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="userId"
                                                                   value="@staffUserId" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-danger">
                                                                Disable
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-controller="Admin"
                                                              asp-action="ActivateStaff"
                                                              method="post"
                                                              class="staff-status-form"
                                                              onsubmit="return confirm('Are you sure you want to activate this Staff account?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="userId"
                                                                   value="@staffUserId" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-success">
                                                                Activate
                                                            </button>
                                                        </form>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="staff-empty">
                                                <svg viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="1.5">
                                                    <circle cx="9" cy="7" r="4"/>
                                                    <path d="M2 21v-2a7 7 0 0 1 14 0v2"/>
                                                    <path d="M19 8v6M22 11h-6"/>
                                                </svg>

                                                <h4>No Staff Members Yet</h4>

                                                <p>
                                                    Staff members will appear here
                                                    after their accounts are created.
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
