
@{
    ViewData["Title"] = "Home";
}

<!-- =========================================
     HOME INTRODUCTION
========================================= -->

<section class="home-welcome">
    <div class="container">
        <div class="welcome-content">

            <span class="section-label">
                UNIVERSITY LIBRARY MANAGEMENT SYSTEM
            </span>

            <h1>
                Knowledge is the key
                <span>to every possibility.</span>
            </h1>

            <p>
                Welcome to ULMS — your university library's digital
                destination. Explore academic resources, discover books
                and make your learning journey more convenient.
            </p>

        </div>
    </div>
</section>


<!-- =========================================
     BOOTSTRAP 4 CAROUSEL
========================================= -->

<section class="library-carousel-section">
    <div class="container">

        <div class="carousel-heading">

            <span class="section-label">A PLACE FOR KNOWLEDGE</span>

            <h2>Explore the <span>Library</span></h2>

            <p>
                Discover a learning environment designed to support
                curiosity, knowledge and academic growth.
            </p>

        </div>

        <div id="ulmsLibraryCarousel"
             class="carousel slide"
             data-ride="carousel"
             data-interval="5000"
             data-pause="hover"
             data-wrap="true">

            <!-- Carousel Indicators -->

            <ol class="carousel-indicators">

                <li data-target="#ulmsLibraryCarousel"
                    data-slide-to="0"
                    class="active"></li>

                <li data-target="#ulmsLibraryCarousel"
                    data-slide-to="1"></li>

                <li data-target="#ulmsLibraryCarousel"
                    data-slide-to="2"></li>

                <li data-target="#ulmsLibraryCarousel"
                    data-slide-to="3"></li>

            </ol>


            <!-- Carousel Slides -->

            <div class="carousel-inner">

                <!-- Slide 1 -->

                <div class="carousel-item active">

                    <img src="~/image/home/image_1.png"
                         class="d-block w-100"
                         alt="University library environment" />

                    <div class="carousel-caption">

                        <span>WELCOME TO ULMS</span>

                        <h3>A Space to Discover Knowledge</h3>

                        <p>
                            Explore a welcoming academic environment
                            where learning and discovery come together.
                        </p>

                    </div>

                </div>


                <!-- Slide 2 -->

                <div class="carousel-item">

                    <img src="~/image/home/image_2.png"
                         class="d-block w-100"
                         alt="Library books and reading resources" />

                    <div class="carousel-caption">

                        <span>ACADEMIC RESOURCES</span>

                        <h3>Knowledge Within Your Reach</h3>

                        <p>
                            Discover books and reading resources
                            that support your academic journey.
                        </p>

                    </div>

                </div>


                <!-- Slide 3 -->

                <div class="carousel-item">

                    <img src="~/image/home/image_3.png"
                         class="d-block w-100"
                         alt="Students studying in a library" />

                    <div class="carousel-caption">

                        <span>LEARN AND GROW</span>

                        <h3>Make Every Reading Moment Count</h3>

                        <p>
                            Find inspiration, build knowledge
                            and explore new areas of learning.
                        </p>

                    </div>

                </div>


                <!-- Slide 4 -->

                <div class="carousel-item">

                    <img src="~/image/home/image_4.png"
                         class="d-block w-100"
                         alt="University library collection" />

                    <div class="carousel-caption">

                        <span>EXPLORE ULMS</span>

                        <h3>Your Journey Starts with a Book</h3>

                        <p>
                            Make it easier to discover the academic
                            resources available through ULMS.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Previous Button -->

            <a class="carousel-control-prev"
               href="#ulmsLibraryCarousel"
               role="button"
               data-slide="prev">

                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>

                <span class="sr-only">Previous</span>

            </a>


            <!-- Next Button -->

            <a class="carousel-control-next"
               href="#ulmsLibraryCarousel"
               role="button"
               data-slide="next">

                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>

                <span class="sr-only">Next</span>

            </a>

        </div>

    </div>
</section>


<!-- =========================================
     ABOUT ULMS
========================================= -->

<section class="about-ulms-section">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="about-image-wrap">

                    <img src="~/image/home/image_2.png"
                         alt="Books and university learning resources" />

                    <div class="about-image-caption">

                        <span>ULMS</span>

                        <strong>
                            Connecting Readers with Knowledge
                        </strong>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="about-content">

                    <span class="section-label">
                        ABOUT OUR PLATFORM
                    </span>

                    <h2>
                        Bringing Your
                        <span>Library Closer.</span>
                    </h2>

                    <p>
                        The University Library Management System (ULMS)
                        provides a convenient digital way to explore
                        the university book catalogue and library resources.
                    </p>

                    <p>
                        Whether you are looking for academic reading
                        material or exploring available books, ULMS
                        helps make the discovery process simple and accessible.
                    </p>

                    <div class="about-highlight">

                        <span class="highlight-icon">✦</span>

                        <div>

                            <h4>Discover More</h4>

                            <p>
                                Explore books and make informed choices
                                about your academic reading.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- =========================================
     LIBRARY RESOURCES
========================================= -->

<section class="resources-section">
    <div class="container">

        <div class="resources-heading">

            <span class="section-label">
                WHAT YOU CAN EXPLORE
            </span>

            <h2>
                Everything Starts with
                <span>Curiosity.</span>
            </h2>

            <p>
                Explore the key resources and features available
                through the University Library Management System.
            </p>

        </div>


        <div class="row">

            <!-- Resource 1 -->

            <div class="col-md-4">

                <article class="resource-card">

                    <div class="resource-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z" />
                            <path d="M4 5.5V21M8 7h8M8 11h8" />
                        </svg>

                    </div>

                    <h3>Academic Books</h3>

                    <p>
                        Explore the book catalogue and discover
                        academic reading material for your studies.
                    </p>

                </article>

            </div>


            <!-- Resource 2 -->

            <div class="col-md-4">

                <article class="resource-card">

                    <div class="resource-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5" />
                            <path d="M8 9h.01M12 9h.01M16 9h.01" />
                        </svg>

                    </div>

                    <h3>University Libraries</h3>

                    <p>
                        Explore the library resources maintained
                        across the university library network.
                    </p>

                </article>

            </div>


            <!-- Resource 3 -->

            <div class="col-md-4">

                <article class="resource-card">

                    <div class="resource-icon">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" />
                            <path d="m16 16 5 5M8 11h6M11 8v6" />
                        </svg>

                    </div>

                    <h3>Easy Book Discovery</h3>

                    <p>
                        Search by book title, author or ISBN
                        to find the resources you are looking for.
                    </p>

                </article>

            </div>

        </div>

    </div>
</section>


<!-- =========================================
     LEARNING ENVIRONMENT
========================================= -->

<section class="learning-section">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="learning-content">

                    <span class="section-label">
                        LEARNING NEVER STOPS
                    </span>

                    <h2>
                        Read More.
                        <span>Discover More.</span>
                    </h2>

                    <p>
                        Every book opens a door to new ideas.
                        Explore academic subjects, discover useful
                        reading material and continue building
                        your knowledge.
                    </p>

                    <ul class="learning-list">

                        <li>
                            <span>✓</span>
                            Discover books in the university catalogue
                        </li>

                        <li>
                            <span>✓</span>
                            Search using title, author or ISBN
                        </li>

                        <li>
                            <span>✓</span>
                            Check book availability in the catalogue
                        </li>

                    </ul>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="learning-image">

                    <img src="~/image/home/image_3.png"
                         alt="University library learning environment" />

                </div>

            </div>

        </div>

    </div>
</section>


<!-- =========================================
     SINGLE CALL TO ACTION
========================================= -->

<section class="home-cta">
    <div class="container">

        <div class="cta-content">

            <span class="section-label">
                START YOUR DISCOVERY
            </span>

            <h2>Find Your Next Learning Resource.</h2>

            <p>
                Explore the university book catalogue
                and discover what you can read next.
            </p>

            <a asp-controller="Books"
               asp-action="Index"
               class="btn cta-button">

                Browse Books
                <span aria-hidden="true">→</span>

            </a>

        </div>

    </div>
</section>


@section Scripts {

    <script>
        $(document).ready(function () {

            $('#ulmsLibraryCarousel').carousel({
                interval: 5000,
                pause: 'hover',
                wrap: true,
                keyboard: true
            });

        });
    </script>

}
